PROJECT_NAME=ContextOS
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/v1

# Option 1: Groq API (Fast & Free tier available)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional: Default model (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
DEFAULT_MODEL=llama-3.3-70b-versatile

# Option 2: OpenAI API / OpenAI-Compatible (OpenRouter, DeepSeek, Local Ollama)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Database
DATABASE_URL=postgresql://contextos:contextos_password@localhost:5432/contextos_db

# Redis Cache
REDIS_URL=redis://localhost:6379/0

